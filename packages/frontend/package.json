{
  "name": "@flode/frontend",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "description": "FLODE's Home Assistant panel — Lit + Home Assistant's own components, canvas on @xyflow/system",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@flode/shared": "workspace:*",
    "@flode/transpiler": "workspace:*",
    "@flode/ui-core": "workspace:*",
    "@xyflow/system": "^0.0.78",
    "i18next": "^26.3.4",
    "js-yaml": "^4.3.2",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.11"
  }
}
