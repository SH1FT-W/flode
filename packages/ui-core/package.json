{
  "name": "@flode/ui-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-free UI core shared by FLODE's editors: node summaries, their strings, summary context",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@flode/shared": "workspace:*",
    "i18next": "^26.3.4"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
